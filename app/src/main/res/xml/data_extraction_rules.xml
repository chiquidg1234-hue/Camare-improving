<?xml version="1.0" encoding="utf-8"?>
<!-- Sin copias en la nube ni transferencias: sólo hay preferencias locales de la cámara. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
